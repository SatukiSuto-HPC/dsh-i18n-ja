{
  "name": "dsh-i18n-ja-core",
  "description": "DSH Web GUI 日本語ロケールパック（コア）: registers the 日本語 language and carries the ja dictionaries for every DSH core plugin namespace (common, settings.*, chat, workspace, …). Independent of dsh-i18n-ja (dsh-web-all family); missing keys fall back to English through the SDK chain.",
  "version": "0.1.2",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SatukiSuto-HPC/dsh-i18n-ja.git",
    "directory": "packages/dsh-i18n-ja-core"
  },
  "bugs": {
    "url": "https://github.com/SatukiSuto-HPC/dsh-i18n-ja/issues"
  },
  "homepage": "https://github.com/SatukiSuto-HPC/dsh-i18n-ja/tree/main/packages/dsh-i18n-ja-core#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "i18n",
    "locale",
    "language-pack",
    "japanese",
    "日本語"
  ]
}
